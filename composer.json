{
  "name": "panfareast/opaque-auth",
  "homepage": "https://github.com/panfareast/php-opaque-auth",
  "description": "OPAQUE password authentication for PHP, built with Rust",
  "type": "php-ext",
  "license": ["MIT", "Apache-2.0"],
  "require": {
    "php": ">=8.3 <8.6"
  },
  "php-ext": {
    "extension-name": "opaque_auth",
    "support-zts": true,
    "support-nts": true,
    "build-path": "pie",
    "os-families": ["linux", "darwin"]
  }
}
